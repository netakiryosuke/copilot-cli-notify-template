{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "nohup setsid ~/.local/bin/watch-ask-user.sh > /dev/null 2>&1 &",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "pkill -f watch-ask-user.sh || true",
        "timeoutSec": 5
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "~/.local/bin/notify.sh '✅ Copilot' 'タスクが完了しました'",
        "timeoutSec": 10
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "~/.local/bin/notify.sh '🤖 サブエージェント' '処理が完了しました'",
        "timeoutSec": 10
      }
    ],
    "postToolUse": [
      {
        "type": "command",
        "bash": "~/.local/bin/copilot-post-tool.sh",
        "timeoutSec": 10
      }
    ],
    "errorOccurred": [
      {
        "type": "command",
        "bash": "~/.local/bin/notify.sh '⚠️ エラー発生' 'Copilotでエラーが発生しました'",
        "timeoutSec": 10
      }
    ]
  }
}